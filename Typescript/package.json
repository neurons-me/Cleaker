{
  "name": "cleaker",
  "version": "4.0.1",
  "description": "Who am I here. — Resolves a me:// namespace to an identity, a transport and a surface: binds who you are to where you are.",
  "type": "module",
  "main": "dist/cleaker.cjs",
  "module": "dist/cleaker.es.js",
  "browser": "dist/cleaker.umd.js",
  "unpkg": "dist/cleaker.umd.js",
  "jsdelivr": "dist/cleaker.umd.js",
  "types": "dist-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "import": "./dist/cleaker.es.js",
      "require": "./dist/cleaker.cjs"
    }
  },
  "files": [
    "dist",
    "dist-types"
  ],
  "scripts": {
    "build": "npm run typecheck && vite build && npm run build:types",
    "typecheck": "tsc --noEmit",
    "build:types": "node -e \"require('fs').rmSync('dist-types',{recursive:true,force:true})\" && tsc -p tsconfig.types.json",
    "docs:api": "typedoc",
    "docs:api:watch": "typedoc --watch",
    "docs:dev": "vitepress dev typedocs",
    "docs:build": "vitepress build typedocs",
    "docs:preview": "vitepress preview typedocs",
    "docs:publish": "npm run docs:api && npm run docs:build",
    "test": "npm run test:axioms && npm run test:bind && npm run test:namespace && npm run test:nrp-target && npm run test:me-target && npm run test:space && npm run test:fallback && npm run test:namespace-constant && npm run test:port-namespace && npm run test:group",
    "test:bind": "tsx tests/bind.test.ts",
    "test:group": "tsx tests/group.test.ts",
    "test:axioms": "tsx tests/axioms.test.ts",
    "test:namespace": "tsx tests/namespace-expression.test.ts",
    "test:nrp-target": "tsx tests/nrp-target.test.ts",
    "test:me-target": "tsx tests/me-target.test.ts",
    "test:space": "tsx tests/space.test.ts",
    "test:fallback": "tsx tests/namespace-fallback.test.ts",
    "test:namespace-constant": "tsx tests/namespace-constant-resolution.test.ts",
    "test:port-namespace": "tsx tests/port-namespace.contract.test.ts",
    "prebuild": "npm test"
  },
  "keywords": [
    "cleaker",
    "me://",
    "namespace",
    "nrp",
    "namespace-resolution-protocol",
    "identity",
    "contextual-binding",
    "semantic-mounting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/neurons-me/Cleaker.git"
  },
  "bugs": {
    "url": "https://github.com/neurons-me/Cleaker/issues"
  },
  "homepage": "https://neurons-me.github.io/Cleaker/",
  "docs": "https://docs.neurons.me/cleaker/index.html",
  "author": {
    "name": "sui.gn",
    "url": "https://neurons.me",
    "email": "dev@neurons.me"
  },
  "license": "MIT",
  "repoType": "NPM Package",
  "category": "utils",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.13",
    "this.me": "^3.4.5",
    "tsx": "^4.20.6",
    "typedoc": "^0.28.16",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.6",
    "vitepress": "^1.6.4"
  }
}
